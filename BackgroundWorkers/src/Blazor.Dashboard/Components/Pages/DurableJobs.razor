@page "/durable-jobs"
@rendermode InteractiveServer
@inject DurableJobService DurableJobService
@inject JobService JobService
@implements IDisposable

@using System.ComponentModel.DataAnnotations
@using RequestProcessor

<PageTitle>Durable Jobs</PageTitle>

<!-- ── Page header ──────────────────────────────────────────────────────── -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Durable Jobs</h2>
    <div class="d-flex align-items-center gap-3">
        <div class="input-group input-group-sm" style="width:260px">
            <span class="input-group-text">Owner</span>
            <input class="form-control" @bind="_ownerId" @bind:event="onchange" @bind:after="ManualRefreshAsync" />
        </div>
        <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" role="switch" id="autoRefreshSwitch"
                   checked="@_autoRefresh" @onchange="ToggleAutoRefresh" />
            <label class="form-check-label text-muted small" for="autoRefreshSwitch">
                Auto-refresh
            </label>
        </div>
        <button class="btn btn-sm btn-outline-primary" @onclick="RecoverAsync" disabled="@_recovering"
                title="Resubmit unfinished jobs whose owning silo is gone">
            ♻ Recover unfinished
        </button>
        <button class="btn btn-sm btn-outline-danger" @onclick="RetryAllFailedAsync"
                disabled="@(_retryingAll || !_jobs.Any(DurableJobService.IsRetryable))"
                title="Resubmit every failed job">
            ↻ Retry failed
        </button>
        <button class="btn btn-sm btn-outline-secondary" @onclick="ManualRefreshAsync"
                disabled="@_refreshing" title="Refresh jobs">
            @if (_refreshing)
            {
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            }
            else
            {
                <span>↺ Refresh</span>
            }
        </button>
    </div>
</div>

<!-- ── Submit form ─────────────────────────────────────────────────────── -->
<div class="card shadow-sm mb-4">
    <div class="card-header p-0">
        <ul class="nav nav-tabs card-header-tabs px-3" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link @(_activeTab == Tab.Submit ? "active" : "")"
                        @onclick='() => _activeTab = Tab.Submit' type="button" role="tab">
                    Submit Job
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(_activeTab == Tab.Stats ? "active" : "")"
                        @onclick='() => _activeTab = Tab.Stats' type="button" role="tab">
                    Pool Stats
                </button>
            </li>
        </ul>
    </div>
    <div class="card-body">
        @if (_activeTab == Tab.Submit)
        {
        <EditForm Model="_form" OnValidSubmit="SubmitAsync" FormName="submit-durable-job">
            <DataAnnotationsValidator />
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label">Payload</label>
                    <InputText class="form-control" @bind-Value="_form.Payload" />
                    <ValidationMessage For="() => _form.Payload" class="text-danger small" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Category <span class="text-muted fw-normal small">(optional)</span></label>
                    <InputText class="form-control" @bind-Value="_form.Category" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Priority</label>
                    <InputSelect class="form-select" @bind-Value="_form.Priority">
                        @foreach (var p in Enum.GetValues<RequestPriority>())
                        {
                            <option value="@p">@p</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Partial results <span class="text-muted fw-normal small">(0–100)</span></label>
                    <InputNumber class="form-control" @bind-Value="_form.PartialResults" min="0" max="100" />
                    <ValidationMessage For="() => _form.PartialResults" class="text-danger small" />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100" disabled="@_submitting">
                        @if (_submitting)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            <span>Submitting…</span>
                        }
                        else
                        {
                            <span>Submit</span>
                        }
                    </button>
                </div>
            </div>
            @if (_success is not null)
            {
                <div class="alert alert-success mt-3 mb-0 py-2 small">@_success</div>
            }
            @if (_submitError is not null)
            {
                <div class="alert alert-danger mt-3 mb-0 py-2 small">@_submitError</div>
            }
        </EditForm>
        }
        else if (_statsError is not null)
        {
            <div class="alert alert-danger py-2 small mb-0">Could not load pool stats: @_statsError</div>
        }
        else if (_stats is null)
        {
            <div class="text-muted small">Loading…</div>
        }
        else
        {
            var s = _stats;
            <div class="row g-3">
                <div class="col-12">
                    <div class="fw-semibold text-muted small text-uppercase mb-2" style="letter-spacing:.05em">Workers</div>
                    <div class="row g-2">
                        @StatCard(s.SiloCount, "Silos", "text-info")
                        @StatCard(s.ActiveWorkers, "Active", "text-primary")
                        @StatCard(s.MaxConcurrency, "Max Concurrency")
                        @StatCard(s.BoundedCapacity, "Capacity / Priority")
                    </div>
                </div>
                <div class="col-12">
                    <div class="fw-semibold text-muted small text-uppercase mb-2" style="letter-spacing:.05em">Queue Depth</div>
                    <div class="row g-2">
                        @StatCard(s.QueueDepthHigh, "High", "text-danger")
                        @StatCard(s.QueueDepthNormal, "Normal", "text-warning")
                        @StatCard(s.QueueDepthLow, "Low", "text-secondary")
                        @StatCard(s.TotalQueueDepth, "Total")
                    </div>
                </div>
                <div class="col-12">
                    <div class="fw-semibold text-muted small text-uppercase mb-2" style="letter-spacing:.05em">Cumulative</div>
                    <div class="row g-2">
                        @StatCard(s.TotalEnqueued, "Enqueued")
                        @StatCard(s.TotalCompleted, "Completed", "text-success")
                        @StatCard(s.TotalFailed, "Failed", "text-danger")
                        @StatCard(s.TotalCancelled, "Cancelled", "text-warning")
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- ── Jobs table ──────────────────────────────────────────────────────── -->
@if (_loadError is not null)
{
    <div class="alert alert-danger py-2 small">Could not load jobs: @_loadError</div>
}

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between">
        <span class="fw-semibold">Jobs for <code>@_ownerId</code></span>
        <span class="text-muted small">@_jobs.Count total · @_finishedCount finished</span>
    </div>
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Job id</th>
                    <th>Status</th>
                    <th style="width:160px">Progress</th>
                    <th>Message</th>
                    <th class="text-end">Attempts</th>
                    <th class="text-end">Epoch</th>
                    <th class="text-end">Results</th>
                    <th>Owner silo</th>
                    <th>Updated</th>
                    <th class="text-end pe-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (_jobs.Count == 0)
                {
                    <tr><td colspan="10" class="text-center text-muted py-3">No jobs for this owner.</td></tr>
                }
                @foreach (var job in _jobs)
                {
                    <tr role="button" @onclick="() => ToggleExpanded(job.JobId)">
                        <td class="font-monospace small">@job.JobId</td>
                        <td><span class="badge @StatusBadge(job.Status)">@job.Status</span></td>
                        <td>
                            <div class="progress" style="height:14px">
                                <div class="progress-bar @(job.IsTerminal ? "" : "progress-bar-striped progress-bar-animated")"
                                     style="width:@(job.PercentComplete)%">@job.PercentComplete%</div>
                            </div>
                        </td>
                        <td class="small">@job.Message</td>
                        <td class="text-end">@job.Attempts</td>
                        <td class="text-end">@job.Epoch</td>
                        <td class="text-end">@job.ResultsReceived</td>
                        <td class="small text-muted">@job.OwnerSilo</td>
                        <td class="small text-muted">@job.UpdatedAt.LocalDateTime.ToString("HH:mm:ss")</td>
                        <td class="text-end pe-3">
                            @if (job.Status == JobStatus.Processing)
                            {
                                <button class="btn btn-sm btn-outline-warning"
                                        disabled="@_busyJobs.Contains(job.JobId)"
                                        @onclick="() => CancelAsync(job.JobId)"
                                        @onclick:stopPropagation="true"
                                        title="Cancel this job">
                                    Cancel
                                </button>
                            }
                            @if (DurableJobService.IsRetryable(job))
                            {
                                <button class="btn btn-sm btn-outline-primary"
                                        disabled="@_busyJobs.Contains(job.JobId)"
                                        @onclick="() => RetryAsync(job.JobId)"
                                        @onclick:stopPropagation="true"
                                        title="Resubmit this job with its original request">
                                    Retry
                                </button>
                            }
                        </td>
                    </tr>
                    @if (_expanded.Contains(job.JobId))
                    {
                        <tr class="table-light">
                            <td colspan="10" class="small">
                                @if (job.Request is { } req)
                                {
                                    <div><strong>Request:</strong> payload=<code>@req.Payload</code>, category=@(req.Category ?? "—"), priority=@req.Priority, partialResults=@req.PartialResults</div>
                                }
                                @if (job.Output is not null)
                                {
                                    <div><strong>Output:</strong> <code>@job.Output</code></div>
                                }
                                @if (job.Error is not null)
                                {
                                    <div class="text-danger"><strong>Error:</strong> @job.Error</div>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private enum Tab { Submit, Stats }

    private sealed class DurableJobForm
    {
        [Required]
        public string Payload { get; set; } = "";

        public string? Category { get; set; }
        public RequestPriority Priority { get; set; } = RequestPriority.Normal;

        [Range(0, 100)]
        public int PartialResults { get; set; }
    }

    private static string NewJobId() => $"job-{Guid.NewGuid():N}"[..12];

    private Tab _activeTab = Tab.Submit;
    private RequestPoolStatsSnapshot? _stats;
    private string? _statsError;
    private Timer? _refreshTimer;
    private bool _refreshing, _autoRefresh = true, _submitting, _recovering;
    private string _ownerId = "demo-owner";
    private IReadOnlyList<DurableJobRecord> _jobs = [];
    private int _finishedCount;
    private string? _loadError, _submitError, _success;
    private readonly DurableJobForm _form = new();
    private readonly HashSet<string> _expanded = [];
    private readonly HashSet<string> _busyJobs = [];
    private bool _retryingAll;

    protected override async Task OnInitializedAsync()
    {
        _refreshTimer = new Timer(OnTimerTick, null, TimeSpan.FromMilliseconds(500), TimeSpan.FromMilliseconds(500));
        await RefreshAsync();
    }

    private void OnTimerTick(object? _)
    {
        if (!_autoRefresh) return;
        InvokeAsync(async () =>
        {
            await RefreshAsync();
            StateHasChanged();
        });
    }

    private void ToggleAutoRefresh(ChangeEventArgs e) => _autoRefresh = e.Value is true;

    private async Task ManualRefreshAsync() => await RefreshAsync();

    private async Task RefreshAsync()
    {
        if (_refreshing) return;
        _refreshing = true;
        try
        {
            var owner = _ownerId.Trim();
            if (owner.Length == 0)
            {
                _jobs = [];
                _finishedCount = 0;
                return;
            }
            _jobs = (await DurableJobService.GetJobsAsync(owner)).OrderByDescending(j => j.UpdatedAt).ToList();
            _finishedCount = await DurableJobService.GetFinishedCountAsync(owner);
            _loadError = null;

            var snap = await JobService.GetPoolStatsAsync();
            if (snap is not null)
            {
                _stats = snap;
                _statsError = null;
            }
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
            _statsError = ex.Message;
        }
        finally
        {
            _refreshing = false;
        }
    }

    private async Task SubmitAsync()
    {
        _submitting = true;
        _success = _submitError = null;
        try
        {
            var jobId = NewJobId();
            var request = new JobRequest(
                _form.Payload,
                string.IsNullOrWhiteSpace(_form.Category) ? null : _form.Category,
                _form.Priority,
                _form.PartialResults);
            await DurableJobService.SubmitAsync(_ownerId.Trim(), jobId, request);
            _success = $"Submitted '{jobId}'.";
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            _submitError = ex.Message;
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task RecoverAsync()
    {
        _recovering = true;
        _success = _submitError = null;
        try
        {
            var count = await DurableJobService.RecoverAsync(_ownerId.Trim());
            _success = $"Recovered {count} unfinished job(s).";
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            _submitError = ex.Message;
        }
        finally
        {
            _recovering = false;
        }
    }

    private async Task RetryAsync(string jobId)
    {
        if (!_busyJobs.Add(jobId)) return;
        _success = _submitError = null;
        try
        {
            if (await DurableJobService.RetryAsync(_ownerId.Trim(), jobId))
                _success = $"Retrying '{jobId}'.";
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            _submitError = ex.Message;
        }
        finally
        {
            _busyJobs.Remove(jobId);
        }
    }

    private async Task CancelAsync(string jobId)
    {
        if (!_busyJobs.Add(jobId)) return;
        _success = _submitError = null;
        try
        {
            _success = await DurableJobService.CancelAsync(_ownerId.Trim(), jobId)
                ? $"Cancelled '{jobId}'."
                : $"'{jobId}' had already finished.";
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            _submitError = ex.Message;
        }
        finally
        {
            _busyJobs.Remove(jobId);
        }
    }

    private async Task RetryAllFailedAsync()
    {
        _retryingAll = true;
        _success = _submitError = null;
        try
        {
            var count = await DurableJobService.RetryAllFailedAsync(_ownerId.Trim());
            _success = $"Retried {count} failed job(s).";
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            _submitError = ex.Message;
        }
        finally
        {
            _retryingAll = false;
        }
    }

    private void ToggleExpanded(string jobId)
    {
        if (!_expanded.Remove(jobId)) _expanded.Add(jobId);
    }

    private static RenderFragment StatCard(object value, string label, string valueClass = "") =>
        @<div class="col-6 col-sm-3">
            <div class="card text-center border-0 bg-light h-100">
                <div class="card-body py-2 px-1">
                    <div class="fs-4 fw-bold @valueClass">@value</div>
                    <div class="text-muted small">@label</div>
                </div>
            </div>
        </div>;

    private static string StatusBadge(JobStatus status) => status switch
    {
        JobStatus.Pending => "text-bg-secondary",
        JobStatus.Processing => "text-bg-primary",
        JobStatus.Completed => "text-bg-success",
        JobStatus.Failed => "text-bg-danger",
        JobStatus.Cancelled => "text-bg-warning",
        _ => "text-bg-light",
    };

    public void Dispose() => _refreshTimer?.Dispose();
}
